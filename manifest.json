{
  "manifest_version": 3,
  "name": "Auto Refresh",
  "version": "1.1.2",
  "description": "Automatically refresh tabs with keyword detection and auto-click functionality",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Auto Refresh"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"

  }
}
